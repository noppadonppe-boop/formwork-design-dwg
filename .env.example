# Copy to .env (or .env.local) and fill from Firebase console → Project settings → Your apps → Web app.
# When these are empty the app runs in "Local mode" (data saved in this browser only).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: Cloud Functions region (default asia-southeast1) and the local emulator (host:port) for the AI import
VITE_FUNCTIONS_REGION=
VITE_FUNCTIONS_EMULATOR=
