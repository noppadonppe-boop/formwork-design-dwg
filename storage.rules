rules_version = '2';

// NOTE: Storage rules are one ruleset per bucket; merge with other apps' rules before deploying if they use this bucket.
service firebase.storage {
  match /b/{bucket}/o {
    // FormWork Studio files — shared by every signed-in user (anonymous included), ≤ 50 MB each
    match /RC-FormWork-Design-Web-App/root/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.resource == null || request.resource.size < 50 * 1024 * 1024);
    }
  }
}
